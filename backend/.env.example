APP_NAME=Deam Smart Society Gate
APP_ENV=dev
APP_TIMEZONE=Asia/Kolkata
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./gate.db
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DATA_ENCRYPTION_KEY=generate-a-fernet-key-and-replace-this
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
GATE_MODE=mock
SERIAL_PORT=COM3
SERIAL_BAUD=115200
GATE_OPEN_TTL_MS=8000
FACE_MODEL_DIR=models
FACE_MATCH_THRESHOLD=0.363
FACE_MIN_WIDTH_PX=80
FACE_MIN_SHARPNESS=60
PENDING_TIMEOUT_SECONDS=120
ALLOW_ASK_RESIDENT_ON_FACE_FAIL=true
SNAPSHOT_RETENTION_DAYS=30
MOCK_FAIL_RATE=0.0
KIOSK_API_KEY=
